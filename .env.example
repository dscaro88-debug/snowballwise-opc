# snowballwise OPC 系统 · 环境变量
# 复制本文件为 .env 并填入真实值；部署到 Vercel 时在后台 Settings → Environment Variables 添加同名变量。

# 站点地址（生成专属链接 /go/{code} 时用）
HOST=https://snowballwise.com

# 端口（本地开发用，部署平台会自行指定）
PORT=3000

# ===== 数据库（二选一）=====
# 方案A：Supabase（生产推荐，持久化、可扩展）
# 在 Supabase 后台 → Project Settings → API 获取下面三项
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...你的service_role_key（注意：不是 anon key，service_role 才有写权限）

# 方案B：本地 JSON 存储（默认，无需配置，仅本地/挂载卷的开发环境）
# 不填 SUPABASE_URL 时自动回退到 data/store.json
